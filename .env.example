# ---- AI engine -------------------------------------------------------------
# none | realesrgan-ncnn | replicate
UPSCALE_ENGINE=none

# Real-ESRGAN ncnn-vulkan (local GPU). Install with: npm run setup:engine
# REALESRGAN_BIN=/abs/path/engines/realesrgan/realesrgan-ncnn-vulkan
# REALESRGAN_MODELS_DIR=/abs/path/engines/realesrgan/models
# realesrgan-x4plus (photos, default) | realesrgan-x4plus-anime | realesr-animevideov3 (fast, illustrations)
# REALESRGAN_MODEL=realesrgan-x4plus
# GPU index or "auto"; tile size (0 = auto, lower it on GPUs with little VRAM, e.g. 200)
# REALESRGAN_GPU=auto
# REALESRGAN_TILE=0

# Replicate (hosted, nightmareai/real-esrgan)
# REPLICATE_API_TOKEN=r8_...
# REPLICATE_MODEL_VERSION=f121d640bd286e1fdc67f9799164c1d5be36ff74576ee11c803ae5b665dd46aa
# REPLICATE_MAX_INPUT_PIXELS=2000000

# ---- Limits ----------------------------------------------------------------
# MAX_UPLOAD_MB=25
# MAX_INPUT_PIXELS=25000000
# MIN_OUTPUT_SIDE=16
# MAX_OUTPUT_SIDE=16384
# MAX_OUTPUT_PIXELS=64000000
# MAX_AI_OUTPUT_PIXELS=100000000
# MIN_DPI=1
# MAX_DPI=10000

# ---- Jobs, storage, security ----------------------------------------------
# UPSCALE_TMP_DIR=/tmp/printready-jobs     # must be private to this instance
# JOB_TTL_MINUTES=30
# JOB_TIMEOUT_SECONDS=900
# MAX_CONCURRENT_JOBS=1
# MAX_QUEUED_JOBS=20
# MIN_FREE_DISK_MB=1024
# Required in production (≥32 chars): signs expiring download URLs.
# DOWNLOAD_URL_SECRET=
# RATE_LIMIT_UPLOADS_PER_MINUTE=10
# RATE_LIMIT_REQUESTS_PER_MINUTE=240
# Number of reverse proxies in front of the app (for client IPs in rate limiting)
# TRUST_PROXY_HOPS=0
